{
  "manifest_version": 3,
  "name": "Reactio Draw figures for Overleaf",
  "short_name": "Reactio for Overleaf",
  "version": "0.6.3",
  "description": "Paste Reactio Draw figures into Overleaf with their files, and edit them in Reactio Draw with a double click.",
  "icons": { "128": "images/icon.png" },
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://www.overleaf.com/*"],
  "background": { "service_worker": "dist/background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.overleaf.com/project/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.overleaf.com/project/*"],
      "js": ["dist/bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
